# ─────────────────────────────────────────────────────────────
# CHOUPOTMAN OS — Environment variables
# Copy to .env.local (dev) / .env.production (prod). NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# --- Application ---------------------------------------------------------
# development | staging | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CHOUPOTMAN OS
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Security ------------------------------------------------------------
# 64-char hex secret used to sign sessions & CSRF tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-64-char-hex-secret
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to 1 behind HTTPS (forces Secure cookies). Always 1 in production.
COOKIE_SECURE=0

# --- Bootstrap admin ------------------------------------------------------
# Used ONCE by `npm run db:seed` to create the first Super Admin.
# The account is flagged must_change_password=1 — the initial password only
# works for the very first login and is never stored in clear text.
BOOTSTRAP_ADMIN_USERNAME=Choupotman
BOOTSTRAP_ADMIN_EMAIL=contact@choupotman.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# --- Database -------------------------------------------------------------
# SQLite file path (relative to project root). Swap for a Postgres URL when
# migrating — see docs/DATABASE.md.
DATABASE_PATH=./data/choupotman.db

# --- Storage --------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
BACKUP_DIR=./data/backups

# --- AI (Anthropic) -------------------------------------------------------
# Optional. Without a key the AI layer falls back to a deterministic,
# database-grounded engine so the chatbot and assistant still work.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=1600

# --- Email (SMTP) ---------------------------------------------------------
# Optional. Without SMTP config, emails are rendered and queued in the
# database (visible in /espace-admin/messages) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Boubaker Choupotman <contact@choupotman.com>"

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
